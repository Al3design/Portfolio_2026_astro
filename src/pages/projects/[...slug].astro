---
import { getCollection, render } from 'astro:content';
import { client } from '../../../tina/__generated__/client';
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectDetailLayout from '@/components/ProjectDetailLayout';
import customComponents from '@/components/mdx';
import matter from 'gray-matter';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  const sorted = allProjects
    .filter(p => p.data.showInPortfolio !== false)
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

  return sorted.map((entry, index) => {
    const next = sorted[(index + 1) % sorted.length];
    return {
      params: { slug: entry.id },
      props: { entry, nextSlug: next.id },
    };
  });
}

const { entry, nextSlug } = Astro.props;
const { Content } = await render(entry);
const tinaProps = await client.queries.projects({ relativePath: `${entry.id}.mdx` });

const projectData = {
  ...entry.data,
  slug: entry.id
};

const rawFiles = import.meta.glob<string>(
  '../../content/projects/*.mdx',
  { eager: true, query: '?raw', import: 'default' }
);
const matchedPath = Object.keys(rawFiles).find(p =>
  p.split('/').pop()!.replace('.mdx', '').toLowerCase() === entry.id
);
const rawBody = matchedPath ? matter(rawFiles[matchedPath]).content : '';

const exportMetadata: Record<string, unknown> = {
  title: entry.data.title,
  year: entry.data.year,
  type: entry.data.type,
  role: entry.data.role,
  client: entry.data.client,
  status: entry.data.status,
  impact: entry.data.impact,
  description: entry.data.description,
  stack: entry.data.stack,
};
---

<MainLayout title={`${entry.data.title} | Al3Design`}>
  <ProjectDetailLayout
    client:load
    project={projectData}
    query={tinaProps.query}
    variables={tinaProps.variables}
    data={tinaProps.data}
    nextLink={`/projects/${nextSlug}`}
    exportData={{
      content: rawBody,
      metadata: exportMetadata,
      filename: `${entry.id}.md`,
    }}
  >
    <Content components={customComponents} />
  </ProjectDetailLayout>
</MainLayout>
