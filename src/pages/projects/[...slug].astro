---
import { getCollection } from 'astro:content';
import ProjectDocument from '@/components/ProjectDocument.astro';
import { projectSource, projectIsPublished } from '@/lib/project-editorial';
import { projectLanguages, projectDefaultLanguage, projectUrl } from '@/lib/project-locales';
import type { SiteLanguage } from '@/lib/site-navigation';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  const sorted = entries
    .filter(entry => projectIsPublished(entry.id) && projectSource(entry.id).metadata.showInPortfolio !== false)
    .map(entry => projectSource(entry.id))
    .sort((a, b) => (a.metadata.order ?? 0) - (b.metadata.order ?? 0));
  return sorted.flatMap((item, index) => projectLanguages(item.metadata).map(language => {
    const others = [...sorted.slice(index + 1), ...sorted.slice(0, index)];
    const next = others.find(other => projectLanguages(other.metadata).includes(language)) ?? others[0] ?? item;
    const nextLanguage = projectLanguages(next.metadata).includes(language) ? language : projectDefaultLanguage(next.metadata);
    return {
      params: {slug: projectUrl(item.slug, item.metadata, language).replace('/projects/', '')},
      props: {documentSlug: item.slug, language, nextLink: projectUrl(next.slug, next.metadata, nextLanguage)},
    };
  }));
}
interface Props { documentSlug: string; language: SiteLanguage; nextLink: string; }
---
<ProjectDocument {...Astro.props} />
