---
import { getCollection } from 'astro:content';
import { client } from '../../tina/__generated__/client';
import MainLayout from '@/layouts/MainLayout.astro';
import ClientHome from '@/components/ClientHome';
// gray-matter is a transitive dependency (via Astro). Used to parse custom
// frontmatter fields that Astro v6's content layer doesn't expose via p.data.
import matter from 'gray-matter';
import { projectSource, projectIsPublished } from '@/lib/project-editorial';
import { localizedProject } from '@/lib/project-locales';

const tinaProps = await client.queries.pages({ relativePath: 'home.mdx' });
const homeData = tinaProps.data.pages as any;
const allProjects = await getCollection('projects');

const rawMdxFiles = import.meta.glob<string>(
  '../content/projects/*.mdx',
  { eager: true, query: '?raw', import: 'default' }
);
const categoryMap: Record<string, string[]> = {};
for (const [filePath, content] of Object.entries(rawMdxFiles)) {
  // Normalize to lowercase — Astro lowercases p.id but filenames may be mixed-case
  const slug = filePath.split('/').pop()!.replace('.mdx', '').toLowerCase();
  const { data } = matter(content);
  categoryMap[slug] = Array.isArray(data.categories) ? data.categories : [];
}

const projects = allProjects
  .filter(p => projectIsPublished(p.id) && projectSource(p.id).metadata.showInPortfolio !== false)
  .map(p => ({
    ...p.data,
    ...localizedProject(projectSource(p.id).metadata),
    slug: p.id,
    categories: categoryMap[p.id] ?? [],
  }))
  .sort((a, b) => (a.order || 0) - (b.order || 0));

const exportContent = projects.map(p => {
  const parts = [`## ${p.title}`];
  if (p.year) parts.push(`**Year:** ${p.year}`);
  if (p.type) parts.push(`**Type:** ${p.type}`);
  if (p.role) parts.push(`**Role:** ${p.role}`);
  if (p.client) parts.push(`**Client:** ${p.client}`);
  if (p.description) parts.push(`\n${p.description}`);
  if (p.stack?.length) parts.push(`\n**Stack:** ${p.stack.join(', ')}`);
  if (p.points?.length) {
    parts.push('\n**Key Points:**');
    p.points.forEach((pt: string) => parts.push(`- ${pt}`));
  }
  return parts.join('\n');
}).join('\n\n---\n\n');

const exportMetadata = {
  title: homeData?.title || 'Compiled Visions',
  description: homeData?.mission || 'UX/UI designer with over 14 years of experience.',
  projects: projects.length,
  generatedAt: new Date().toISOString(),
};
---

<MainLayout description={`${homeData?.mission || 'Multimedia designer working across UX/UI, web interfaces and 3D.'} Explore Alejandro Delgado's published projects in interface design, web development, 3D and animation.`}>
  <ClientHome
    client:load
    projects={projects}
    query={tinaProps.query}
    variables={tinaProps.variables}
    data={tinaProps.data}
    exportData={{
      content: exportContent,
      metadata: exportMetadata,
      filename: "portfolio-projects.md",
    }}
  />
</MainLayout>
