---
import { getCollection } from 'astro:content';
import { client } from '../../tina/__generated__/client';
import MainLayout from '@/layouts/MainLayout.astro';
import ClientArchive from '@/components/ClientArchive';
import { projectIsPublished, projectSource } from '@/lib/project-editorial';
import { localizedProject } from '@/lib/project-locales';

const tinaProps = await client.queries.pages({ relativePath: 'archive.mdx' });
const title = (tinaProps.data.pages as any).title ?? 'Project Archive';

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter(p => projectIsPublished(p.id) && projectSource(p.id).metadata.showInPortfolio !== false)
  .map(p => ({ ...p.data, ...localizedProject(projectSource(p.id).metadata), slug: p.id }))
  .sort((a, b) => {
    const yearA = parseInt(a.year || '0');
    const yearB = parseInt(b.year || '0');
    return yearB - yearA;
  });
---

<MainLayout title={`${title} | Al3Design`} description={(tinaProps.data.pages as any).subtitle || 'Browse published work by Alejandro Delgado across interface design, web development, 3D and animation.'}>
  <ClientArchive
    client:load
    projects={projects}
    query={tinaProps.query}
    variables={tinaProps.variables}
    data={tinaProps.data}
  />
</MainLayout>
