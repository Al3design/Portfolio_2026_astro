---
import MainLayout from '@/layouts/MainLayout.astro';
import ShopProductLivePreview from '@/components/ShopProductLivePreview';
import { client } from '../../tina/__generated__/client';
import { siWhatsapp } from 'simple-icons';
import ShopPalette from './ShopPalette.astro';
import styles from '@/styles/pages/_shop-review.module.scss';
import shopStyles from '@/styles/pages/_shop.module.scss';
import { shopReviewDrafts, shopReviewImage, shopReviewFilamentColours } from '@/lib/shop-review';
import { shopRoutes, type ShopLanguage } from '@/data/shop-demo';

if (import.meta.env.MODE !== 'development') return new Response(null, { status: 404 });
interface Props { language?: ShopLanguage; slug?: string; storefrontPreview?: boolean }
const { language = Astro.params.language, slug = Astro.params.slug, storefrontPreview = false } = Astro.props;
if (language !== 'es' && language !== 'en') return new Response(null, { status: 404 });
Astro.response.headers.set('Cache-Control', 'no-store');
const [drafts, filamentColours] = await Promise.all([shopReviewDrafts(), shopReviewFilamentColours()]);
const selected = slug ? drafts.find(item => item.slug === slug) : undefined;
if (slug && !selected) return new Response(null, { status: 404 });
const tinaProps = selected ? await client.queries.shopProduct({ relativePath: `${selected.slug}.json` }) : undefined;
const en = language === 'en';
const categoryLabels = {
  home: en ? 'Home & decor' : 'Hogar y deco',
  desk: en ? 'Desk' : 'Escritorio',
  organization: en ? 'Organization' : 'Organización',
  design: en ? 'Design objects' : 'Objetos de diseño',
};
const t = en ? {
  title: 'Printed pieces', review: 'Store 3D / Local review', draft: 'Draft', pending: 'To confirm',
  intro: 'Photos of real prints and working descriptions. Review each piece before including it in the collection.',
  back: 'Back to all pieces', photos: 'Photos of the print',
  fields: 'Object and delivery details', notes: 'Internal notes',
  editor: 'Open Tina editor', photoPending: 'Photo pending', original: 'Open original photo',
  noSale: 'Editorial review. Sales are not enabled for these pieces.',
  empty: 'No saved drafts yet.', noDescription: 'Description pending.',
  updated: 'Open a piece from the Tina collection to edit it with Live Preview.',
  status: 'Editorial status', reviewStatus: 'For review',
} : {
  title: 'Piezas impresas', review: 'Store 3D / Revisión local', draft: 'Borrador', pending: 'Por confirmar',
  intro: 'Fotos de impresiones reales y descripciones en preparación. Revisá cada pieza antes de incorporarla a la colección.',
  back: 'Volver a todas las piezas', photos: 'Fotos de la impresión',
  fields: 'Datos de la pieza y entrega', notes: 'Notas internas',
  editor: 'Abrir editor Tina', photoPending: 'Foto pendiente', original: 'Abrir foto original',
  noSale: 'Revisión editorial. Estas piezas no tienen venta habilitada.',
  empty: 'Todavía no hay borradores guardados.', noDescription: 'Descripción pendiente.',
  updated: 'Abrí una pieza desde la colección de Tina para editarla con Live Preview.',
  status: 'Estado editorial', reviewStatus: 'Para revisar',
};
const titleFor = (product: typeof drafts[number]['product']) => product.locales?.[language]?.title?.trim() || t.pending;
const detailUrl = (id: string, locale: ShopLanguage = language) => storefrontPreview
  ? `${shopRoutes[locale]}?catalog=real&piece=${encodeURIComponent(id)}`
  : `/revision/tienda/${locale}/${id}`;
const collectionLink = (locale: ShopLanguage) => storefrontPreview ? `${shopRoutes[locale]}?catalog=real` : `/revision/tienda/${locale}/`;
const collectionUrl = collectionLink(language);
const editorUrl = selected
  ? `/admin/index.html#/collections/edit/shopProduct/${encodeURIComponent(selected.slug)}`
  : '/admin/index.html#/collections/shopProduct/~';
---
<MainLayout
  section="shop" language={language} noIndex analytics={false}
  title={`${selected ? titleFor(selected.product) : t.title} · Store 3D · ${t.draft}`}
  description={t.intro}
  languageLinks={{ es: slug ? detailUrl(slug, 'es') : collectionLink('es'), en: slug ? detailUrl(slug, 'en') : collectionLink('en') }}
  shopCollectionHref={`${collectionUrl}#collection`}
  shopNotice={en ? 'Local review · photos of real prints · sales not enabled' : 'Revisión local · fotos de impresiones reales · venta no habilitada'}
>
    <div id="collection" class={styles.main}>
      {selected && tinaProps ? <ShopProductLivePreview client:load
        query={tinaProps.query} variables={tinaProps.variables} data={tinaProps.data}
        language={language} backHref={`${collectionUrl}#${selected.slug}`}
        references={filamentColours} iconPath={siWhatsapp.path}
      /> : <>
        <header class={styles.intro}><p class={styles.meta}>{t.draft}</p><h1>{t.title}</h1><p>{t.intro}</p></header>
        <div class={shopStyles.shop__products}>
          {drafts.map(({ slug: id, product }) => {
            const photo = product.photos?.find(item => shopReviewImage(item));
            const media = shopReviewImage(photo);
            return <article id={id} class={`${shopStyles.shop__product} ${styles.product}`}>
              <a class={styles.productLink} href={detailUrl(id)} aria-label={`${en ? 'View piece' : 'Ver pieza'}: ${titleFor(product)}`}>
                <div class={styles.productImage}>
                  {media ? <img src={media.url} alt="" loading="lazy" decoding="async" /> : <span>{t.photoPending}</span>}
                  {media && <span class={shopStyles.shop__imageTag}>{en ? 'Real print' : 'Impresión real'}</span>}
                </div>
                <h2>{titleFor(product)}</h2>
                {product.category && <p class={styles.productCategory}>{categoryLabels[product.category]}</p>}
                <ShopPalette colours={product.palette} legacyColours={product.photographedColours} references={filamentColours} language={language} compact />
                <span class={styles.productAction}>{en ? 'View piece' : 'Ver pieza'} ↗</span>
              </a>
            </article>;
          })}
        </div>
        {!drafts.length && <p>{t.empty}</p>}
      </>}
      <aside class={styles.footer} aria-label={t.review}>
        <p>{t.noSale}</p>
        <a class={styles.action} href={editorUrl}>{t.editor}</a>
        <p>{t.updated}</p>
      </aside>
    </div>
</MainLayout>
