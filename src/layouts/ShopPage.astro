---
import ShopLanding from '@/layouts/ShopLanding.astro';
import type { ShopLanguage } from '@/data/shop-demo';

interface Props { language: ShopLanguage }
const { language } = Astro.props;
const realPreview = import.meta.env.MODE === 'development' && Astro.url.searchParams.get('catalog') === 'real';
const Review = realPreview ? (await import('../editorial/ShopReview.astro')).default : undefined;
---
{Review ? <Review language={language} slug={Astro.url.searchParams.get('piece') ?? undefined} storefrontPreview /> : <ShopLanding language={language} />}
