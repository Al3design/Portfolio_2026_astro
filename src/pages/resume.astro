---
import { getCollection } from 'astro:content';
import { client } from '../../tina/__generated__/client';
import MainLayout from '@/layouts/MainLayout.astro';
import ClientResume from '@/components/ClientResume';
import { projectIsPublished, projectSource, projectSources } from '@/lib/project-editorial';
import { localizedProject, projectLanguages, projectDefaultLanguage, projectUrl } from '@/lib/project-locales';
import type { RelatedProjectLink } from '@/lib/experience-links';

const tinaProps = await client.queries.pages({ relativePath: 'resume.mdx' });
const pageData = tinaProps.data.pages as any;

const projects = await getCollection('projects');
function relatedProjects(experienceSlug: string): RelatedProjectLink[] {
  return projectSources.filter(item => item.metadata.experienceSlug === experienceSlug).flatMap(item => {
    const publicPage = projectIsPublished(item.slug) && item.metadata.showInPortfolio !== false;
    if (!publicPage && !import.meta.env.DEV) return [];
    const language = projectLanguages(item.metadata).includes('en') ? 'en' : projectDefaultLanguage(item.metadata);
    const copy = localizedProject(item.metadata, language);
    return [{title: copy.title ?? item.slug, href: projectUrl(item.slug, item.metadata, language, !publicPage), draft: !publicPage}];
  });
}
const jobs = projects
  .filter(p => projectIsPublished(p.id))
  .map(p => ({...p.data, ...localizedProject(projectSource(p.id).metadata), slug: p.id, relatedProjects: relatedProjects(p.id)}))
  .filter(p => p.showInResume)
  .sort((a, b) => (a.order || 99) - (b.order || 99));

const exportContent = jobs.map(job => {
  const parts = [`## ${job.role || job.title}`];
  if (job.client) parts.push(`**Company:** ${job.client}`);
  if (job.year) parts.push(`**Period:** ${job.year}`);
  if (job.type) parts.push(`**Type:** ${job.type}`);
  if (job.description) parts.push(`\n${job.description}`);
  if (job.stack?.length) parts.push(`\n**Stack:** ${job.stack.join(', ')}`);
  if (job.points?.length) {
    parts.push('\n**Highlights:**');
    job.points.forEach((pt: string) => parts.push(`- ${pt}`));
  }
  if (job.relatedProjects.length) parts.push('\n**Related projects:**\n' + job.relatedProjects.map(item => `- [${item.title.replace(/\s*\/\/\s*/g, ' ')}](${item.href})${item.draft ? ' (Draft)' : ''}`).join('\n'));
  return parts.join('\n');
}).join('\n\n---\n\n');

const exportMetadata = {
  title: pageData.title || 'Resume',
  location: pageData.location,
  email: pageData.email?.trim() || undefined,
  status: pageData.status,
  generatedAt: new Date().toISOString(),
};
---

<MainLayout title={`Resume | ${pageData.title}`}>
  <ClientResume
    client:load
    jobs={jobs}
    query={tinaProps.query}
    variables={tinaProps.variables}
    data={tinaProps.data}
    exportData={{
      content: exportContent,
      metadata: exportMetadata,
      filename: "cv-alejandro-delgado.md",
    }}
  />
</MainLayout>
