---
import ShopCatalogue from '@/layouts/ShopCatalogue.astro';
import { shopCatalogue, type ShopCatalogueProduct } from '@/lib/shop-catalogue';
export async function getStaticPaths() {
  return (await shopCatalogue()).map(product => ({ params: { slug: product.slug }, props: { product } }));
}
interface Props { product: ShopCatalogueProduct }
const { product } = Astro.props;
---
<ShopCatalogue language="en" product={product} />
