---
import { client } from '../../tina/__generated__/client';
import MainLayout from '@/layouts/MainLayout.astro';
import ClientAbout from '@/components/ClientAbout';

const [tinaProps, resumeProps] = await Promise.all([
  client.queries.pages({ relativePath: 'about.mdx' }),
  client.queries.pages({ relativePath: 'resume.mdx' }),
]);
const location = (resumeProps.data.pages as { location?: string }).location?.trim();
---

<MainLayout title={`About Alejandro Delgado | Al3Design`} description={`${(tinaProps.data.pages as any).mission || 'Multimedia design across UX/UI, web development and 3D.'} Learn about Alejandro Delgado's work, tools and approach to design and implementation.`}>
  <ClientAbout
    client:load
    query={tinaProps.query}
    variables={tinaProps.variables}
    data={tinaProps.data}
    location={location}
  />
</MainLayout>
