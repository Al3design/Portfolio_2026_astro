{
  "name": "astro-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "core-js",
      "esbuild",
      "fallow",
      "protobufjs",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "tinacms dev --port 4002 --datalayer-port 9001 -c \"astro dev --port 4322\"",
    "build": "tinacms build && astro build",
    "preview": "astro preview",
    "test:e2e": "e2e run --reporter list,markdown",
    "mcp:e2e": "e2e mcp --headless --config e2e.config.ts",
    "test:mcp": "node scripts/check-browser-mcp.mjs",
    "astro": "astro",
    "build:local": "tinacms dev --port 4002 --datalayer-port 9001 -c \"astro build\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/roboto-mono": "^5.2.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.2.2",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simple-icons": "^12.4.0",
    "slate": "^0.124.1",
    "slate-dom": "^0.124.1",
    "slate-hyperscript": "^0.100.0",
    "slate-react": "^0.124.0",
    "tinacms": "^3.7.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@e2e-dev/web": "0.12.0",
    "@tinacms/cli": "^2.2.5",
    "e2e": "0.17.0",
    "fallow": "^2.69.0",
    "fs-extra": "^11.3.5",
    "sass": "^1.99.0",
    "typescript": "^6.0.3"
  }
}
