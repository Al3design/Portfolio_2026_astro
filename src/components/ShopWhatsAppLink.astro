---
import { siWhatsapp } from 'simple-icons';
import ShopWhatsAppButton from './ShopWhatsAppButton';

interface Props { href: string; describedBy?: string }
const { href, describedBy } = Astro.props;
---
<ShopWhatsAppButton href={href} describedBy={describedBy} iconPath={siWhatsapp.path}><slot /></ShopWhatsAppButton>
